AI_SERVER_URL=http://127.0.0.1:8000
AI_SERVER_TIMEOUT=180
AI_IMAGE_PROVIDER=selfhosted

# Existing flattened-design OCR/vision provider. Keep credentials only in backend/.env.
AI_VISION_PROVIDER=gemini
GEMINI_API_KEY=
AI_VISION_MODEL=gemini-3.8-flash

# Optional existing OpenAI adapter credentials.
AI_API_KEY=
AI_EDIT_PROVIDER=mock
DESIGN_RENDER_FONT=Arial, Noto Sans, sans-serif